
{
  "servers": {
    "mongodb": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "mongodb_mcp_server.server"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "MONGODB_URI": "mongodb+srv://<username>:<password>@<cluster-host>/",
        "MONGODB_DATABASE": "ecommerce"
      }
    }
  }
}
